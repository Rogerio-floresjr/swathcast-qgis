{
  "$comment": "SwathCast design tokens: the single source for the QGIS plugin and the swathview web app. Edit here, then run scripts/build.py (CSS + contrast report) and scripts/sync_plugin.py. Keys are snake_case; CSS variables are --sc-<key-with-dashes>.",
  "name": "SwathCast",
  "version": "1.0.1",
  "color": {
    "dark": {
      "background": "#11161f",
      "text": "#e6eef8",
      "muted": "#9fb3c8",
      "title": "#6cb4ff",
      "panel": "#1b2230",
      "panel_border": "#2f3e54",
      "field": "#202020",
      "button": "#25406a",
      "button_hover": "#2f5288",
      "button_border": "#4a7fc1",
      "button_text": "#e6f1ff",
      "primary": "#2b72d6",
      "primary_hover": "#2868c8",
      "primary_text": "#ffffff",
      "rail": "#141a24",
      "rail_checked": "#22324a",
      "accent": "#6cb4ff",
      "link": "#6cb4ff",
      "pill": "#1f4f8f",
      "pill_text": "#dcebff",
      "check": "#3d8ef0",
      "error": "#ff8a8a",
      "ok": "#7fd1a8",
      "disabled": "#5b6878"
    },
    "light": {
      "background": "#ffffff",
      "text": "#1b2733",
      "muted": "#536476",
      "title": "#1458a8",
      "panel": "#f5f8fc",
      "panel_border": "#c9d7ea",
      "field": "#ffffff",
      "button": "#e7f0fb",
      "button_hover": "#d5e5f8",
      "button_border": "#5f86bd",
      "button_text": "#0f4a8f",
      "primary": "#1f6fd1",
      "primary_hover": "#185fb6",
      "primary_text": "#ffffff",
      "rail": "#eaf0f7",
      "rail_checked": "#d3e3f7",
      "accent": "#1458a8",
      "link": "#1458a8",
      "pill": "#1f6fd1",
      "pill_text": "#ffffff",
      "check": "#1f6fd1",
      "error": "#b00020",
      "ok": "#1e7a4c",
      "disabled": "#a3afbd"
    }
  },
  "data": {
    "$comment": "Colours that carry data (footprints, swatches). Orange is allowed here (Landsat), never in the interface chrome.",
    "mission": {
      "cbers-4": "#2ca25f", "cbers-4-mux": "#66c2a4", "cbers-4a": "#006d2c",
      "cbers-4a-mux": "#41ae76", "cbers-4a-wpm": "#99d8c9", "amazonia-1": "#a1d76a",
      "sentinel-1": "#6a51a3", "sentinel-2": "#2171b5", "sentinel-3": "#6baed6",
      "landsat-8": "#d94801", "landsat-9": "#fd8d3c",
      "terra": "#b8860b", "aqua": "#e6ab02",
      "suomi-npp": "#8c6d31", "noaa-20": "#bd9e39", "noaa-21": "#e7cb94",
      "pace": "#e7298a", "enmap": "#a50f15", "prisma": "#ef3b2c"
    },
    "mission_fallback": ["#4e79a7", "#f28e2b", "#59a14f", "#e15759", "#b07aa1", "#76b7b2"],
    "footprint_fill_alpha": 0.06,
    "footprint_outline": {
      "default": "solid",
      "cycle_projected": "dash",
      "tasking_required": "dot"
    },
    "selection": {"fill": "#282828", "fill_alpha": 0.43, "flash": "#ffffff", "flash_alpha": 0.55, "flash_ms": 600}
  },
  "type": {
    "$comment": "px for the web, pt for Qt (QGIS sets the base font; the plugin only scales from it).",
    "family_web": "\"Poppins\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "app_name": {"px": 20, "pt": 15, "weight": 700},
    "section_title": {"px": 13, "pt": 9, "weight": 700},
    "body": {"px": 13, "pt": 9, "weight": 400},
    "button": {"px": 13, "pt": 9, "weight": 700},
    "primary_button": {"px": 15, "pt": 11, "weight": 700},
    "chip": {"px": 12, "pt": 9, "weight": 400},
    "pill": {"px": 11, "pt": 8, "weight": 700},
    "rail_label": {"px": 10, "pt": 7.5, "weight": 400}
  },
  "radius": {"panel": 6, "button": 5, "chip": 10, "pill": 8, "field": 3, "card": 8},
  "space": {"xs": 2, "s": 4, "m": 6, "l": 8, "xl": 12},
  "size": {
    "rail_width": 70,
    "rail_icon": 22,
    "panel_min_width": 360,
    "panel_max_width_web": 420,
    "spinner": 22,
    "logo_card_width": 160,
    "header_icon": 30
  },
  "motion": {"spinner_step_ms": 70, "spinner_step_deg": 30}
}
