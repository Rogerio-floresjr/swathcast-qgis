    family-names: Flores Junior
    email: rogerio.floresjr@gmail.com
license: GPL-2.0-or-later
version: 0.4.0
date-released: "2026-11-06"
repository-code: "https://github.com/Rogerio-floresjr/swathcast-qgis"
url: "https://swathview.pages.dev/docs#qgis"
keywords:
  - QGIS
  - remote sensing
  - satellite overpass
  - acquisition planning
  - CBERS
  - Sentinel
  - Landsat
